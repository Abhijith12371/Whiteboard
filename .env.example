# DigiBoard Environment Variables

# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Get these from your Supabase project: Settings → API
# These keys are safe to use in the client application

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# CLOUDFLARE R2 CONFIGURATION (Future - Server-side only)
# ==============================================================================
# These should NEVER be in the client application
# Use a separate backend API/serverless function to handle R2 uploads

# R2_ACCOUNT_ID=your-r2-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=digiboard-assets
# R2_PUBLIC_URL=https://your-r2-public-url.com

# ==============================================================================
# DEVELOPMENT
# ==============================================================================
# Optional: Set to 'development' for additional logging
# NODE_ENV=development
