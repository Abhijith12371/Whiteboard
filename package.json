{
  "name": "microsoftwhiteboardclone",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pack": "electron-builder --win"
  },
  "build": {
    "appId": "com.digiboard.app",
    "productName": "Whiteboard",
    "copyright": "Copyright © 2026 Digiboard",
    "protocols": [
      {
        "name": "DigiBoard board link",
        "schemes": [
          "digiboard"
        ]
      }
    ],
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "appx"
      ],
      "icon": "build/icon.ico"
    },
    "appx": {
      "applicationId": "AbhijithN.Digiboard",
      "backgroundColor": "#4f46e5",
      "displayName": "Digiboard",
      "identityName": "AbhijithN.Digiboard",
      "publisher": "CN=C442DDF1-9670-4E19-B9FD-354F70E192AD",
      "publisherDisplayName": "Abhijith_N"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "konva": "^10.3.2",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
